# syntax=docker/dockerfile:1

ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        git \
        python3 \
        python3-pip \
        python3-venv \
        unzip \
        zip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv "${VIRTUAL_ENV}" \
    && python -m pip install --upgrade pip setuptools wheel

WORKDIR /workspace
COPY . .

RUN python -c 'from pathlib import Path; import tomllib; project = tomllib.loads(Path("pyproject.toml").read_text(encoding="utf-8")); requirements = project["project"]["optional-dependencies"]["dev"]; Path("/tmp/patchharbor-test-requirements.txt").write_text("".join(f"{item}\n" for item in requirements), encoding="utf-8")' \
    && python -m pip install --requirement /tmp/patchharbor-test-requirements.txt \
    && python -m pip show pytest-timeout pipx >/dev/null

RUN rm -rf /tmp/patchharbor-dist \
    && python scripts/build_release.py --outdir /tmp/patchharbor-dist \
    && python -m pip install --force-reinstall /tmp/patchharbor-dist/*.whl \
    && python -m pip check

CMD ["python", "-m", "pytest", "-q", "tests"]
