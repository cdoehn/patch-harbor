{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchharbor.local/schemas/workflow-rules.schema.json",
  "title": "PatchHarbor workflow rules",
  "description": "Generic PatchHarbor workflow-rules document schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Ruleset format version."
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflowRule"
      },
      "uniqueItems": false,
      "description": "Ordered workflow rules. Rule id uniqueness is enforced by the model and validator."
    }
  },
  "$defs": {
    "workflowRule": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "Stable rule identifier."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable rule description."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "default": "general",
          "description": "Generic rule category."
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "default": "error",
          "description": "Diagnostic severity."
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether the rule is active."
        }
      }
    }
  }
}
